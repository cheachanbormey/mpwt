# ==============================================================================
# Production Environment Configuration
# Copy this file to .env on your production server:
# cp .env.production.example .env
# Then generate your key if needed: php artisan key:generate
# ==============================================================================

APP_NAME="HR Management System"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://your-domain.com

APP_PORT=80

APP_TIMEZONE=Asia/Phnom_Penh
APP_LOCALE=km
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=km_KH

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# Database Configuration (matches docker-compose.prod.yml 'db' service)
DB_CONNECTION=mysql
DB_HOST=db
DB_PORT=3306
DB_DATABASE=hrms
DB_USERNAME=hrms_user
DB_PASSWORD=change_this_to_a_strong_password
DB_ROOT_PASSWORD=change_this_to_a_strong_root_password

# Session & Cache (using Redis)
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

CACHE_STORE=redis
CACHE_PREFIX=hrms_cache_

# Queue Configuration
QUEUE_CONNECTION=redis

# Redis Configuration (matches docker-compose.prod.yml 'redis' service)
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=change_this_to_a_strong_redis_password
REDIS_PORT=6379

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local

# Mail Configuration
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailgun.org
MAIL_PORT=587
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="no-reply@your-domain.com"
MAIL_FROM_NAME="${APP_NAME}"

VITE_APP_NAME="${APP_NAME}"
